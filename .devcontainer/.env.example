# Devcontainer Environment Variables (Per-Worktree Overrides)
#
# RECOMMENDED: Use the shared config instead (works across all worktrees):
#   ~/.config/dev-container/devcontainer.env
#
# This file is OPTIONAL and only needed for worktree-specific overrides.
# For most cases, just use the shared config.
#
# To set up shared config (ONE TIME, works for all worktrees):
#   mkdir -p ~/.config/dev-container
#   echo 'CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...' > ~/.config/dev-container/devcontainer.env
#
# Per-worktree overrides (optional):
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...different-token...
